{
    "name": "kataknyulink/livewire-datatable",
    "description": "Modular advanced datatable for Laravel Livewire with Flux UI. Supports nested rows, sorting, search, filters, and toggleable columns via traits.",
    "keywords": [
        "laravel",
        "livewire",
        "flux-ui",
        "datatable",
        "table"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Katak Nyulink",
            "email": "itsupport.vbdev@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "KatakNyulink\\LivewireDatatable\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KatakNyulink\\LivewireDatatable\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.17",
        "illuminate/database": "^13.17",
        "livewire/livewire": "^4.1",
        "livewire/flux": "^2.13.1"
    },
    "require-dev": {
        "pestphp/pest": "^2.0|^3.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0",
        "pestphp/pest-plugin-livewire": "^2.0|^3.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "KatakNyulink\\LivewireDatatable\\DatatableServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}